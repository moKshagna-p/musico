{
  "name": "musico",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:bun": "node ./scripts/check-bun.mjs",
    "dev": "npm run check:bun && turbo run dev --parallel",
    "build": "npm run check:bun && turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "preview": "npm run preview --workspace=@musico/web",
    "dev:web": "npm run dev --workspace=@musico/web",
    "dev:api": "npm run check:bun && turbo run dev --filter=@musico/api",
    "start:api": "npm run check:bun && turbo run start --filter=@musico/api",
    "start:api:local": "bun run --cwd apps/api start:local",
    "db:migrate:api": "bun run --cwd apps/api db:migrate",
    "build:web": "npm run build --workspace=@musico/web",
    "start:web": "npm run preview --workspace=@musico/web -- --host 0.0.0.0 --port ${PORT:-4173}"
  },
  "devDependencies": {
    "puppeteer": "^24.40.0",
    "turbo": "^2.5.6"
  }
}

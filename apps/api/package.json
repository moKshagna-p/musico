{
  "name": "@musico/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env run --watch index.ts",
    "start": "bun run db:migrate && bun run index.ts",
    "start:local": "bun --env-file=../../.env run db:migrate:local && bun --env-file=../../.env run index.ts",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:migrate:local": "bun --env-file=../../.env drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "bun --env-file=../../.env drizzle-kit studio --config=drizzle.config.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@neondatabase/serverless": "^0.10.4",
    "better-auth": "^1.3.4",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.5",
    "elysia": "^1.4.22",
    "lru-cache": "^11.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.1"
  }
}

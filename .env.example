# Frontend
VITE_API_BASE_URL=http://localhost:4000

# Backend (Elysia/Bun server)
PORT=4000
ALLOWED_ORIGIN=http://localhost:5173
DISCOGS_TOKEN=your_discogs_token
# Optional server-only Vercel relay for Cloudflare Workers deployments.
DISCOGS_RELAY_URL=
DISCOGS_RELAY_SECRET=
DISCOGS_USER_AGENT=musico/1.0 (+http://localhost:4000)
SEARCH_CACHE_TTL_MS=21300000
DISCOGS_MIN_REQUEST_INTERVAL_MS=1100
DISCOGS_REQUEST_TIMEOUT_MS=10000
HOMEPAGE_REFRESH_MINIMAL=false
HOME_RELEASE_DETAILS_PREWARM_LIMIT=6
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxxxx.us-east-1.aws.neon.tech/musico?sslmode=require
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
CRON_SECRET=replace_with_a_long_random_secret
# Optional: fanart.tv personal API key for wide artist backgrounds, artist logos and CD art (https://fanart.tv/get-an-api-key/)
FANART_API_KEY=your_fanart_api_key
# Optional: TheAudioDB key for artist logos and CD art. Defaults to the shared free key "123", which is for development only.
THEAUDIODB_API_KEY=your_theaudiodb_api_key
# Optional: KLIPY API key for GIFs in reviews (https://partner.klipy.com). Without it the GIF button is hidden.
KLIPY_API_KEY=your_klipy_api_key
